# Database Configuration
# For development: Use SQLite
DATABASE_URL=sqlite:///./data/dev.db

# For production: Use PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/review_trust_db

# API Configuration (Optional - for future use)
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here

# Model Configuration (Optional)
# MODEL_PATH=./ml/model.pkl
# SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# SerpAPI Configuration (for Google Maps place analysis)
# Get your key at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
# OLLAMA_URL=http://host.docker.internal:11434  # Docker 環境

# Discord Labeling Bot (scripts/discord_labeling_bot.py, runs in WSL2)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_LABELING_CHANNEL_ID=your_channel_id_here
API_BASE_URL=http://localhost:8000
